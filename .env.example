# Copy this file to .env and adjust as needed. All values below are the same
# development defaults already baked into docker-compose.yml and config-repo/*.yml -
# override them here only if you need something different locally.
# These are NOT production secrets.

# Database (shared username/password across all per-service Postgres instances)
DB_USERNAME=user
DB_PASSWORD=password
# Only needed to override a service's JDBC URL when running outside docker-compose
DB_URL=

# Hibernate DDL mode (validate in any environment with Flyway-managed schema)
DDL_AUTO=update
SHOW_SQL=false

# Auth service JWT
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# API Gateway CORS
ALLOWED_ORIGINS=http://localhost:3000

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Notifications service SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Grafana admin password
GRAFANA_PASSWORD=password

# Frontend
REACT_APP_API_URL=http://localhost:8080
